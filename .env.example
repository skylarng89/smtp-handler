# Copy to .env and fill in. Used by deploy/compose/single-app.yaml.

# --- SMTP account the service sends through ---
SMTPH_SMTP_HOST=smtp.example.com
SMTPH_SMTP_PORT=587
SMTPH_SMTP_USERNAME=apikey-or-username
SMTPH_SMTP_PASSWORD=change-me
# starttls (587, default) | tls (465) | none (local dev only)
SMTPH_SMTP_TLS=starttls

# --- Sender and keys ---
SMTPH_FROM=My App <no-reply@example.com>
# Generate with: docker run --rm smtp-handler keys generate -type publishable
SMTPH_PUBLISHABLE_KEY_HASHES=sha256:...
SMTPH_ALLOWED_ORIGINS=https://app.example.com
SMTPH_SECRET_KEY_HASHES=sha256:...

# --- Templates (mounted at /templates in the compose file) ---
SMTPH_TEMPLATES_DIR=/templates

# --- Optional admin UI (queue view, retry/cancel) ---
SMTPH_ADMIN_ENABLED=false
SMTPH_UI_ENABLED=false
# docker run --rm -i smtp-handler hash-password   (note: escape every $ as $$ in compose files)
SMTPH_ADMIN_PASSWORD_HASH=
SMTPH_ADMIN_SESSION_SECRET=
